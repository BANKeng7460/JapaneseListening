{
  "name": "kiku-listening",
  "version": "1.0.0",
  "description": "Japanese listening practice with cumulative Kaishi vocabulary tests",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "kaishi:extract": "node --disable-warning=ExperimentalWarning scripts/kaishi-anki.mjs extract",
    "kaishi:progress": "node --disable-warning=ExperimentalWarning scripts/kaishi-anki.mjs progress",
    "levels:build": "node scripts/build-kaishi-levels.cjs && node scripts/word-hint-forms.cjs && node scripts/grammar-usage.cjs && node scripts/build-mistakes.cjs && node scripts/line-words.cjs",
    "levels:check": "node scripts/check-level-vocab.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kuromoji": "^0.1.2",
    "typescript": "^7.0.2"
  }
}
