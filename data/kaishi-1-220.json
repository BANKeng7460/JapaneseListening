  "questions": [
    {
      "situation": "Making plans · Friends",
      "lines": [
        {
          "speaker": "A",
          "text": "明日、何時に会う？",
          "translation": "What time shall we meet tomorrow?"
        },
        {
          "speaker": "B",
          "text": "十時はどう？",
          "translation": "How about ten?"
        },
        {
          "speaker": "A",
          "text": "悪い、十時はまだ仕事なんだ。一時なら大丈夫。",
          "translation": "Sorry, I’m still at work at ten. One o’clock is fine."
        },
        {
          "speaker": "B",
          "text": "分かった。じゃあ一時に駅の前で待ってるね。",
          "translation": "Got it. Then I’ll wait in front of the station at one."
        }
      ],
      "question": "What time will they meet?",
      "choices": [
        "At one o’clock",
        "At ten o’clock",
        "At nine o’clock",
        "In the evening"
      ],
      "answer": 0,
      "explanation": "十時 (じゅうじ) and 一時 (いちじ): 時 is read じ for clock times. まだ仕事 means still at work. 悪い is a casual “sorry” between friends. Extra word: 駅 (えき), station."
    },
    {
      "situation": "A late start · Coworkers",
      "lines": [
        {
          "speaker": "A",
          "text": "田中さん、今朝はどうしたんですか。",
          "translation": "Tanaka, what happened this morning?"
        },
        {
          "speaker": "B",
          "text": "すみません。七時に家を出たんですが、電車がなかなか来なかったんです。",
          "translation": "I’m sorry. I left home at seven, but the train just wouldn’t come."
        },
        {
          "speaker": "A",
          "text": "そうでしたか。顔色が悪いですよ。大丈夫ですか。",
          "translation": "I see. You look pale. Are you all right?"
        },
        {
          "speaker": "B",
          "text": "はい、大丈夫です。今から頑張ります。",
          "translation": "Yes, I’m fine. I’ll get to work now."
        }
      ],
      "question": "Why was Tanaka late?",
      "choices": [
        "Tanaka overslept",
        "The train didn’t come for a long time",
        "Tanaka felt sick at home",
        "Tanaka forgot the time"
      ],
      "answer": 1,
      "explanation": "今朝 (けさ) means this morning. 家を出る (でる) means leave home. 顔色が悪い (かおいろがわるい) means to look pale — literally “face color is bad”. すみません is a polite apology. Extra word: 電車 (でんしゃ), train."
    },
    {
      "situation": "A family photo · Friends",
      "lines": [
        {
          "speaker": "A",
          "text": "これ、誰の写真？",
          "translation": "Whose photo is this?"
        },
        {
          "speaker": "B",
          "text": "うちの家族だよ。六人家族なんだ。",
          "translation": "My family. There are six of us."
        },
        {
          "speaker": "A",
          "text": "六人？大きな家族だね。",
          "translation": "Six? That’s a big family."
        },
        {
          "speaker": "B",
          "text": "うん。父と母と兄が三人、そして私。",
          "translation": "Yeah. My dad, my mom, three older brothers, and then me."
        },
        {
