    {
      "situation": "Taking a break from studying",
      "lines": [
        {
          "speaker": "A",
          "text": "今日はもう勉強をやめます。",
          "translation": "I’ll stop studying for today."
        },
        {
          "speaker": "B",
          "text": "そうですか。明日、また頑張りましょう。",
          "translation": "All right. Let’s do our best again tomorrow."
        },
        {
          "speaker": "A",
          "text": "はい。明日も手伝ってくれますか。",
          "translation": "Yes. Will you help me tomorrow too?"
        },
        {
          "speaker": "B",
          "text": "もちろんです。",
          "translation": "Of course."
        }
      ],
      "question": "What will A do today?",
      "choices": [
        "Continue studying all night",
        "Stop studying forever",
        "Stop studying for today",
        "Start a new job"
      ],
      "answer": 2,
      "explanation": "止める read やめる means stop doing an activity, written やめます here for clarity. 頑張る means persevere/do one’s best. A will study again tomorrow."
