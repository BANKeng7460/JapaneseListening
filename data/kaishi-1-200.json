  "questions": [
    {
      "situation": "A new task · Casual conversation",
      "lines": [
        {
          "speaker": "A",
          "text": "俺、今度の仕事は難しいと思う。今日始めたんだけど、全く分からない。",
          "translation": "I think this current job is difficult. I started today, but I don’t understand it at all."
        },
        {
          "speaker": "B",
          "text": "どこが分からない？",
          "translation": "Which part don’t you understand?"
        },
        {
          "speaker": "A",
          "text": "この言葉の意味だよ。",
          "translation": "The meaning of this word."
        },
        {
          "speaker": "B",
          "text": "じゃあ、一緒に調べよう。",
          "translation": "Then let’s look it up together."
        }
      ],
      "question": "What part does A need help with?",
      "choices": [
        "The meaning of a word",
        "Finding the room",
        "Choosing a job",
        "Remembering a name"
      ],
      "answer": 0,
      "explanation": "俺 is a very casual, typically masculine I. 難しい means difficult. 今度 refers here to this current occasion/job, explicitly already started today. 全く with a negative means not at all. Extra forms: どこが, which part; 一緒に, together."
    },
    {
      "situation": "An unexpected absence",
      "lines": [
        {
          "speaker": "A",
          "text": "あの男の子と女の子は、まだ来ていませんか。",
          "translation": "Have that boy and girl not arrived yet?"
        },
        {
          "speaker": "B",
          "text": "はい。いつもここにいるのに、今日はおかしいですね。",
          "translation": "That’s right. They are always here, so it’s unusual today."
        },
        {
          "speaker": "A",
          "text": "なぜ来ないのでしょう。先生に聞いてみます。",
          "translation": "I wonder why they aren’t coming. I’ll ask the teacher."
        },
        {
          "speaker": "B",
          "text": "お願いします。",
          "translation": "Please do."
        }
      ],
      "question": "What seems unusual to B?",
      "choices": [
        "The room is crowded",
        "The two children are absent today",
        "The teacher is speaking loudly",
        "The children have new books"
      ],
      "answer": 1,
      "explanation": "男の子 means boy; 女の子 means girl. おかしい means strange/unusual here; なぜ means why. いるのに expresses although they are usually here."
    },
    {
      "situation": "Passing on a message",
      "lines": [
        {
