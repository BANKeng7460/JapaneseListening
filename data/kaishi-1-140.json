    {
      "situation": "Choosing a place to study",
      "lines": [
        {
          "speaker": "A",
          "text": "この部屋で勉強しましょうか。",
          "translation": "Shall we study in this room?"
        },
        {
          "speaker": "B",
          "text": "ここは声がよく聞こえません。勉強するには悪い場所ですね。",
          "translation": "I can’t hear voices well here. It’s a bad place for studying."
        },
        {
          "speaker": "A",
          "text": "では、あの部屋はどうですか。",
          "translation": "Then how about that other room?"
        },
        {
          "speaker": "B",
          "text": "まあ、あそこなら大丈夫だと思います。",
          "translation": "Well, I think it’ll be okay over there."
        }
      ],
      "question": "Why does B suggest using a different room?",
      "choices": [
        "The room has no books",
