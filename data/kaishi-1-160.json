  "questions": [
    {
      "situation": "Studying the same book",
      "lines": [
        {
          "speaker": "A",
          "text": "私も同じ本を使っています。一緒に勉強してもいいですか。",
          "translation": "I’m using the same book too. May I study with you?"
        },
        {
          "speaker": "B",
          "text": "もちろんです。",
          "translation": "Of course."
        },
        {
          "speaker": "A",
          "text": "この本で勉強するのは、とても楽しいですね。",
          "translation": "Studying with this book is very enjoyable."
        },
        {
          "speaker": "B",
          "text": "はい、私もそう思います。",
          "translation": "Yes, I think so too."
        }
      ],
      "question": "How does B respond to studying together?",
      "choices": [
        "B agrees readily",
        "B refuses",
        "B asks A to wait until next week",
        "B wants a different book"
      ],
      "answer": 0,
      "explanation": "同じ means same; もちろん means of course. とても means very, and 楽しい means enjoyable. Extra expression: 一緒に means together."
    },
    {
      "situation": "Arriving late",
      "lines": [
        {
          "speaker": "A",
          "text": "遅くなって、申し訳ないです。",
          "translation": "I’m sorry I’m late."
        },
        {
          "speaker": "B",
          "text": "大丈夫ですよ。どうぞ入ってください。",
          "translation": "It’s all right. Please come in."
        },
        {
          "speaker": "A",
          "text": "失礼します。",
          "translation": "Excuse me."
        },
        {
          "speaker": "B",
          "text": "ここに本があります。使ってください。",
          "translation": "There’s a book here. Please use it."
        }
      ],
      "question": "What does B tell A to do?",
      "choices": [
        "Wait outside",
        "Come in and use a book",
        "Return tomorrow",
        "Call the teacher"
      ],
      "answer": 1,
      "explanation": "申し訳ない expresses an apology; more formal speech often uses 申し訳ありません. 失礼します is a polite expression when entering or leaving. Extra form: 遅くなって (おそくなって), having become late."
    },
    {
      "situation": "Helping with work",
      "lines": [
        {
          "speaker": "A",
          "text": "今日は仕事が忙しいですか。",
          "translation": "Are you busy with work today?"
        },
        {
          "speaker": "B",
          "text": "はい。もう少し続けます。",
          "translation": "Yes. I’ll keep working a little longer."
        },
        {
          "speaker": "A",
          "text": "手伝いましょうか。",
          "translation": "Shall I help?"
        },
        {
          "speaker": "B",
          "text": "ありがとうございます。お願いします。",
          "translation": "Thank you. Please do."
        }
      ],
      "question": "What does A offer?",
      "choices": [
        "To bring dinner",
        "To cancel the work",
        "To help B",
        "To go home"
      ],
      "answer": 2,
      "explanation": "仕事 means work; 忙しい means busy. 続ける means continue; 手伝いましょうか offers help. もう少し means a little more."
