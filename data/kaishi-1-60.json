    {
      "situation": "A classmate",
      "lines": [
        {
          "speaker": "A",
          "text": "彼女の名前を知っていますか。",
          "translation": "Do you know her name?"
        },
        {
          "speaker": "B",
          "text": "はい、アンちゃんです。",
          "translation": "Yes, it’s Ann."
        },
        {
          "speaker": "A",
          "text": "アンちゃんは学校に来ますか。",
          "translation": "Will Ann come to school?"
        },
        {
          "speaker": "B",
          "text": "はい、明日来ます。",
          "translation": "Yes, she’ll come tomorrow."
        }
      ],
      "question": "When will Ann come to school?",
      "choices": [
        "Today",
        "Tomorrow",
        "Next week",
        "She will not come"
      ],
      "answer": 1,
      "explanation": "Focus: 彼女 (she), 知る (know), ちゃん (familiar name suffix), 学校, 来る, 明日. アン is a name. ちゃん is affectionate/familiar, not a default suffix for strangers."
    },
    {
