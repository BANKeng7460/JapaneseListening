  "questions": [
    {
      "situation": "Time to study",
      "lines": [
        {
          "speaker": "A",
          "text": "今、時間はありますか。",
          "translation": "Do you have time now?"
        },
        {
          "speaker": "B",
          "text": "いいえ、今は時間がないです。",
          "translation": "No, I don’t have time now."
        },
        {
          "speaker": "A",
          "text": "日本語の勉強はしますか。",
          "translation": "Will you study Japanese?"
        },
        {
          "speaker": "B",
          "text": "今はしません。",
          "translation": "Not now."
        }
      ],
      "question": "What does B say?",
      "choices": [
        "B has plenty of time",
        "B has no time and won’t study now",
        "B will teach Japanese now",
        "B studies all day"
      ],
      "answer": 1,
      "explanation": "Focus: 今 (now), 時間 (time), 無い／ない (not exist). 時間がないです means I have no time. 今はしません means I won’t do it now."
    },
    {
      "situation": "An uninteresting book",
      "lines": [
        {
          "speaker": "A",
          "text": "その本は面白いですか。",
          "translation": "Is that book interesting?"
