  "questions": [
    {
      "situation": "Visiting a family home",
      "lines": [
        {
          "speaker": "A",
          "text": "どうぞ、入ってください。",
          "translation": "Please come in."
        },
        {
          "speaker": "B",
          "text": "大きな家ですね。家族みんなで住んでいますか。",
          "translation": "What a large house. Does your whole family live here?"
        },
        {
          "speaker": "A",
          "text": "はい、家族で住んでいます。",
          "translation": "Yes, I live here with my family."
        },
        {
          "speaker": "B",
          "text": "いいですね。",
          "translation": "That’s nice."
        }
      ],
      "question": "Who lives in the house?",
      "choices": [
        "A and A’s family",
        "Only A",
        "Only A’s teacher",
        "A and some classmates"
      ],
      "answer": 0,
      "explanation": "入って is the て-form of 入る (enter). 家族 means family; 住んでいます describes living somewhere. 大きな goes directly before a noun: 大きな家."
    },
    {
      "situation": "Speaking in class",
      "lines": [
        {
          "speaker": "A",
          "text": "私の声、聞こえますか。",
          "translation": "Can you hear my voice?"
        },
        {
          "speaker": "B",
          "text": "はい。でも、もう少し大きい声でお願いします。",
          "translation": "Yes. But please use a slightly louder voice."
        },
        {
          "speaker": "A",
          "text": "分かりました。分からない人は手を上げてください。",
          "translation": "Understood. If you don’t understand, please raise your hand."
        },
        {
          "speaker": "B",
          "text": "はい、お願いします。",
          "translation": "Okay, thank you."
        }
      ],
      "question": "What should learners do if they do not understand?",
      "choices": [
        "Leave the room",
        "Raise a hand",
        "Speak to a friend",
        "Close the book"
      ],
      "answer": 1,
      "explanation": "声 means voice. 大きい声 is a loud voice; 手を上げる means raise a hand. Extra forms: 聞こえますか asks whether a sound is audible; もう少し means a little more."
    },
    {
      "situation": "Choosing a picture book",
      "lines": [
        {
          "speaker": "A",
          "text": "この本の絵はどうですか。",
          "translation": "What do you think of the pictures in this book?"
        },
        {
          "speaker": "B",
          "text": "この人の目がちょっと怖いです。こういう絵は嫌いです。",
          "translation": "This person’s eyes look a little scary. I dislike pictures like this."
        },
        {
          "speaker": "A",
          "text": "では、あの本を見ましょう。",
          "translation": "Then let’s look at that other book."
        },
        {
          "speaker": "B",
          "text": "はい、そうしましょう。",
          "translation": "Yes, let’s do that."
        }
      ],
      "question": "Why does B want to look at another book?",
      "choices": [
        "The text is too small",
        "B has already read it",
        "B dislikes the scary-looking eyes in the pictures",
        "It costs too much"
      ],
      "answer": 2,
      "explanation": "目 means eye; 嫌い means dislike. Extra words: 絵 (え), picture; 怖い (こわい), scary. こういう means this kind of."
    },
    {
      "situation": "Asking about grandparents",
      "lines": [
        {
          "speaker": "A",
          "text": "おじいさんとおばあさんは元気ですか。",
          "translation": "Are your grandfather and grandmother well?"
        },
        {
          "speaker": "B",
          "text": "はい、二人とも元気です。いつも一緒に町を歩いています。",
          "translation": "Yes, both are well. They always walk around town together."
        },
        {
          "speaker": "A",
          "text": "いいですね。今日もですか。",
          "translation": "That’s nice. Today too?"
        },
        {
          "speaker": "B",
          "text": "はい、今日もです。",
          "translation": "Yes, today too."
        }
      ],
      "question": "How are B’s grandparents?",
      "choices": [
        "Only the grandfather is well",
        "Neither is well",
        "Only the grandmother is well",
        "Both are well"
      ],
      "answer": 3,
      "explanation": "元気 means healthy or energetic; いつも means always/usually. おじいさん and おばあさん refer here to someone else’s grandparents. Extra expressions: 二人とも (ふたりとも), both people; 一緒に (いっしょに), together; 歩く (あるく), walk."
    },
